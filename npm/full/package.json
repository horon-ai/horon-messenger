{
  "name": "@horon-ai/messenger",
  "version": "0.5.0",
  "description": "Installs and runs every horon-messenger surface: the CLI, the MCP server, the HTTP API server and the terminal UI.",
  "keywords": [
    "messenger",
    "kakaotalk",
    "discord",
    "telegram",
    "slack",
    "whatsapp",
    "cli",
    "mcp",
    "server",
    "tui",
    "horon"
  ],
  "license": "MIT",
  "homepage": "https://github.com/horon-ai/horon-messenger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horon-ai/horon-messenger.git"
  },
  "bugs": {
    "url": "https://github.com/horon-ai/horon-messenger/issues"
  },
  "bin": {
    "horon-messenger": "bin/horon-messenger.js"
  },
  "files": [
    "bin/"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@horon-ai/messenger-server-mcp-tui": "0.5.0"
  },
  "optionalDependencies": {
    "@horon-ai/messenger-cli-darwin-arm64": "0.5.0",
    "@horon-ai/messenger-cli-darwin-x64": "0.5.0",
    "@horon-ai/messenger-cli-linux-x64-gnu": "0.5.0",
    "@horon-ai/messenger-cli-linux-arm64-gnu": "0.5.0",
    "@horon-ai/messenger-cli-win32-x64-msvc": "0.5.0"
  }
}
